# 複製到 repo 外的 worker.env，chmod 600 後再填值；不要提交真實憑證。
# 由 Node --env-file 載入，不必 source；值不會展開 $HOME 或 ~。
REVIEW_API_URL=https://review.sportsmedicine.tw
# 與 Cloudflare Pages secret WORKER_TOKEN 相同；32–512 個 base64url 字元。
# 主憑證最長 90 天，使用 scripts/worker-credentials.mjs 輪替；見 docs/worker-credentials.md。
# 留白會拒絕啟動，不要把 token 放進 plist、命令列或日誌。
REVIEW_WORKER_TOKEN=
REVIEW_WORKSPACE="/absolute/path/to/review-social-workspace"
REVIEW_WORKER_ID=studio
# 草稿使用 codex 或 claude 的既有 CLI 登入。
REVIEW_MODEL_PROVIDER=codex
# 不加空格。未安裝或未登入者會標記 unavailable/failed，不代表查核通過。
REVIEW_REVIEWERS=claude,gemini,grok
# Unpaywall 查詢使用的聯絡 email；不是 API key。
REVIEW_CONTACT_EMAIL=keanu.firefox@gmail.com
# image-probe 成功後，填入同一資料夾的絕對路徑；留白只宣告尚未驗證生圖。
# worker 不會領取 photo/illustration 製圖任務，純文字製圖仍可執行。
REVIEW_IMAGE_PROBE_DIR=
# 已安裝 Playwright Chromium 時不用設定；要用系統 Chrome 才取消註解。
# PW_CHANNEL=chrome
# 不設定 OPENAI_API_KEY、ANTHROPIC_API_KEY、GEMINI_API_KEY 或其他模型 API key。
# 模型 CLI 沿用同一 macOS 使用者的登入；Gemini 必須先在 Gemini CLI 登入。
