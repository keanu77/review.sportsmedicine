{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "review-sportsmedicine",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "review-private-jobs",
      "database_id": "e2921083-9191-4237-9e46-c67ca2d6f947",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "review-private-artifacts"
    }
  ],
  "vars": {
    "OWNER_EMAIL": "keanu.firefox@gmail.com",
    "ACCESS_TEAM_DOMAIN": "sportsmedicine-tw.cloudflareaccess.com",
    "ACCESS_AUD": "5bb366ab9628c0e7e1bdbc9287911dffad628c811672912226ee4fd34b7b3ff6",
    "APP_ORIGIN": "https://review.sportsmedicine.tw"
  }
}
