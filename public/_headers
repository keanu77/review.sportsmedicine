# Cloudflare Pages 回應標頭。
# 公開索引與私人工作台共用的靜態回應標頭；私人 API 另由 Functions 設定。

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# 建置產物帶內容雜湊，可長期快取
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 資料檔每月更新，走 revalidation
/data/*
  Cache-Control: public, max-age=0, must-revalidate

# 登入工作台頁面不索引、不共用快取；API 由 Functions 自行設定
/workbench
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/workbench/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
